{
  "family": "function-graph",
  "version": 1,

  "xAxis": { "min": -0.6, "max": 3.2, "step": 10, "label": "x" },
  "yAxis": { "min": -0.6, "max": 5.6, "step": 10, "label": "y" },
  "grid": false,

  "curves": [
    {
      "expr": "4/(x + 1)^2",
      "domain": [-0.139, 3.0],
      "label": "y = 4/(x + 1)²",
      "labelAt": 2.6,
      "style": "solid"
    },
    {
      "expr": "2 - x",
      "domain": [0, 2],
      "style": "solid"
    }
  ],

  "features": [
    { "type": "point", "curve": 0, "x": 1, "y": 1, "label": "P" },
    { "type": "point", "curve": 1, "x": 2, "y": 0, "label": "Q" },
    { "type": "point", "curve": 1, "x": 0, "y": 2, "label": "R" }
  ],

  "regions": [
    {
      "from": 0,
      "to": 1,
      "upper": { "curve": 0 },
      "lower": { "curve": 1 },
      "statedArea": 0.5
    }
  ]
}
