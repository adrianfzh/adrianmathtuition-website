<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.adrianmath.learnfromadrian</string>

	<!-- The COPY install.sh puts in ~/.adrianmath_learn, not the repo file: the shared
	     website checkout flips branches under peer sessions (find-review precedent). -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/adrianfong/.adrianmath_learn/run.sh</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/Users/adrianfong/.adrianmath_learn</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>LANG</key>
		<string>en_US.UTF-8</string>
	</dict>

	<!-- 07:30 SGT daily (the Mac is on SGT). RunAtLoad = the catch-up for a Mac that was
	     shut at 07:30; the wrapper's once-a-day stamp makes later fires no-ops. -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>7</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>

	<key>RunAtLoad</key>
	<true/>

	<key>StandardOutPath</key>
	<string>/Users/adrianfong/.adrianmath_learn/launchd.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/adrianfong/.adrianmath_learn/launchd.log</string>
</dict>
</plist>
