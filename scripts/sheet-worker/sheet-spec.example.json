{
  "spec_version": 1,
  "_comment": "A one-skill sheet using every block type the house style allows. `render_sheet.py --selftest` renders it and checks the result; copy it as the shape of a real spec. The teaching is deliberately thin — SHEET-SPEC.md and the self-study-sheet skill say what a real one carries.",
  "sheet": {
    "subject": "AM",
    "title": "PRACTICE AGAIN — Learn from A Math 2025 Paper 1",
    "student": "Example Student",
    "papers": ["2025 Paper 1", "2025 Paper 2"]
  },
  "body": [
    { "block": "skill",
      "parts": [ { "t": "Testing A Point Against A Circle: Inside Means " },
                 { "m": "(x-a)^2 + (y-b)^2 < r^2" } ] },

    { "block": "where",
      "parts": [ { "t": "Where it showed: 2025 Paper 1 Q9(a); 2025 Paper 2 Q4" } ] },

    { "block": "keymove",
      "parts": [ { "t": "Substitute the point into " },
                 { "m": "(x-a)^2 + (y-b)^2" },
                 { "t": " and compare with " },
                 { "m": "r^2" },
                 { "t": ". \"Inside\" is an inequality, so an unknown coordinate gives a range of values, not two values." } ] },

    { "block": "example" },
    { "block": "para",
      "parts": [ { "t": "A circle has equation " },
                 { "m": "(x-1)^2 + (y+3)^2 = 50" },
                 { "t": "." } ] },
    { "block": "parts_start" },
    { "block": "part", "marks": 2,
      "parts": [ { "t": "The point " }, { "m": "(\\alpha,\\ 4)" },
                 { "t": " lies inside the circle. Find the set of possible values of " },
                 { "m": "\\alpha" }, { "t": "." } ] },
    { "block": "part", "marks": 2,
      "parts": [ { "t": "Determine whether the point " }, { "m": "(6,\\ 2)" },
                 { "t": " lies inside, on or outside the circle." } ] },

    { "block": "solution",
      "rows": [
        { "label": "(a)",
          "steps": [
            { "step": "note",
              "parts": [ { "t": "Inside the circle means the distance from the centre is less than the radius, so the substituted point gives " },
                         { "m": "< 50" }, { "t": ", not " }, { "m": "= 50" }, { "t": "." } ] },
            { "step": "math",
              "latex": "\\begin{aligned} (\\alpha-1)^2 + (4+3)^2 &< 50 \\quad\\text{← inside: } \\\\ (\\alpha-1)^2 &< 1 \\\\ 0 < \\alpha &< 2 \\end{aligned}" },
            { "step": "prose",
              "parts": [ { "t": "So " }, { "m": "0 < \\alpha < 2", "b": true }, { "t": ". " },
                         { "tag": ["inside: ", { "m": "< r^2" }] } ] },
            { "step": "figure", "width_cm": 8,
              "source": { "figure_lib": { "kind": "graph",
                                          "curves": [ { "expr": "x**2", "domain": [-2, 2], "label": "$y = x^2$" } ],
                                          "xticks": [-2, 0, 2] } } },
            { "step": "error",
              "parts": [ { "t": "Writing " }, { "m": "= 50" },
                         { "t": " and solving for two values. \"Inside\" gives a range." } ] },
            { "step": "check",
              "parts": [ { "m": "\\alpha = 1" }, { "t": " gives " }, { "m": "0 + 49 = 49 < 50" },
                         { "t": " (inside)." } ] } ] },
        { "label": "(b)",
          "steps": [
            { "step": "math", "latex": "(6-1)^2 + (2+3)^2 = 50 \\quad\\text{← equal to } r^2" },
            { "step": "prose",
              "parts": [ { "t": "So " }, { "m": "(6,\\ 2)" }, { "t": " lies " },
                         { "t": "on the circle", "b": true }, { "t": "." } ] } ] } ] },

    { "block": "practice", "label": "Practice 1" },

    { "block": "item", "marks": 3,
      "parts": [ { "t": "The circle " }, { "m": "C" }, { "t": " has equation " },
                 { "m": "x^2 + y^2 - 10x + 6y + 9 = 0" }, { "t": "." } ] },
    { "block": "part", "marks": 3,
      "parts": [ { "t": "Find the coordinates of the centre and the radius of " }, { "m": "C" }, { "t": "." } ] },
    { "block": "part", "marks": 2,
      "parts": [ { "t": "Determine whether " }, { "m": "A(3,\\ -7)" },
                 { "t": " lies inside, outside or on the circle." } ] },
    { "block": "answer",
      "parts": [ { "t": "(a) centre " }, { "m": "(5,\\ -3)" }, { "t": ", radius " }, { "m": "5" },
                 { "t": ";  (b) inside the circle, since " }, { "m": "20 < 25" } ] },

    { "block": "item", "marks": 2,
      "parts": [ { "t": "The table shows how a group of adults travel to work." } ] },
    { "block": "table",
      "rows": [ ["", "Frequency", "Sector angle"],
                ["Cycle", 6, ""],
                ["Public transport", 27, ""],
                ["Drive", 17, ""] ],
      "align": ["left", "center", "center"],
      "widths_cm": [4.6, 3.4, 3.4] },
    { "block": "para", "indent_cm": 1.0,
      "parts": [ { "t": "Calculate the angle of each sector of the pie chart." } ] },
    { "block": "remember",
      "parts": [ { "t": "the angles add up to " }, { "m": "360^\\circ" } ] },
    { "block": "answer",
      "parts": [ { "t": "Cycle " }, { "m": "43.2^\\circ" },
                 { "t": ";  Public transport " }, { "m": "194.4^\\circ" },
                 { "t": ";  Drive " }, { "m": "122.4^\\circ" } ] },

    { "block": "skill",
      "parts": [ { "t": "Using The Given Range To Fix The Quadrants Before Solving" } ] },
    { "block": "keymove",
      "parts": [ { "t": "Read the range first and mark only the quadrants inside it." } ] },
    { "block": "example", "label": "a" },
    { "block": "para", "marks": 3,
      "parts": [ { "t": "Solve " }, { "m": "4\\sin^2\\theta - 3 = 0" }, { "t": " for " },
                 { "m": "\\pi < \\theta < \\frac{3\\pi}{2}" }, { "t": "." } ] },
    { "block": "solution",
      "rows": [ { "label": "",
                  "steps": [ { "step": "math",
                               "latex": "\\begin{aligned} \\sin^2\\theta &= \\frac{3}{4} \\\\ \\sin\\theta &= \\pm\\frac{\\sqrt{3}}{2} \\end{aligned}" },
                             { "step": "prose",
                               "parts": [ { "t": "The 3rd quadrant only, so " },
                                          { "m": "\\theta = \\frac{4\\pi}{3}", "b": true }, { "t": "." } ] } ] } ] },
    { "block": "practice", "label": "Practice 2" },
    { "block": "item", "marks": 4,
      "parts": [ { "t": "Solve " }, { "m": "7\\cot\\theta - 4 = 2\\sin^2\\theta" },
                 { "t": " for " }, { "m": "-\\pi \\leq \\theta \\leq \\pi" }, { "t": "." } ] },
    { "block": "answer",
      "parts": [ { "m": "\\theta = -2.68,\\ -2.55,\\ 0.464" }, { "t": " or " },
                 { "m": "0.588" }, { "t": " (3 s.f.)" } ] }
  ]
}
