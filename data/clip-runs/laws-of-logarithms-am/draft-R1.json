 "beats": [
  {
   "say": "Simplify log base three of five, plus log base three of six, minus log base three of ten.",
   "asks": [
    "What does log base 3 mean?"
   ],
   "do": [
    {
     "do": "write",
     "step": 0
    }
   ]
  },
  {
   "say": "All three logs have the same base, three, so we can combine them.",
   "asks": [
    "Why must the bases be the same?"
   ],
   "do": [
    {
     "do": "highlight",
     "token": [
      "a",
      "b",
      "c"
     ],
     "on": "the same base",
     "part": "sub"
