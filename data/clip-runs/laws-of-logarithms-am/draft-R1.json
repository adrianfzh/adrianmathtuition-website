    {
     "do": "mark",
     "kind": "box",
     "token": "ans",
     "on": "is one."
    }
   ]
  },
  {
   "say": "Watch out: log five times log six is not log thirty. Only added logs combine.",
   "asks": [
    "Why can't I multiply two logs?"
   ],
   "do": [
    {
     "do": "mark",
     "kind": "circle",
     "token": "m6",
     "on": "Watch out"
    },
    {
     "do": "note",
     "text": "✗ Watch out: $\\log_3 5 \\times \\log_3 6 \\neq \\log_3 30$",
