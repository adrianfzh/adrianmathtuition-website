          ]
        },
        {
          "say": "Five times six is thirty. So we have log base three of thirty, minus log base three of ten.",
          "asks": ["Where did 30 come from?"],
          "do": [
            { "do": "write", "step": 3, "on": "So we have" }
          ]
        },
        {
          "say": "Now the minus. Log thirty minus log ten: this is Minus Power.",
