{
  "slug": "sketching-log-graphs-am",
  "draft": "B",
  "beats": [
    {
      "say": "Sketch Y equals L N of two minus X. Four steps: asymptote, shape, draw, intercepts.",
      "do": [
        {
          "do": "write",
          "step": 0
        }
      ]
    },
    {
      "say": "Step one, the asymptote. Let the inside of the log equal zero.",
      "do": [
        {
          "do": "write",
          "token": "in0",
          "on": "inside of the log"
        }
      ]
    },
    {
      "say": "Two minus X equals zero, so the asymptote is X equals two.",
      "do": [
        {
          "do": "note",
          "text": "← Asymptote: inside equals zero",
          "near": "in0"
        },
        {
          "do": "write",
          "token": "asy",
          "on": "X equals two"
        }
      ]
    },
    {
      "say": "Step two, the shape. Minus in front of X flips the graph in the Y axis.",
      "do": [
        {
          "do": "highlight",
          "token": "eqn",
          "on": "Minus in front"
        }
      ]
    },
    {
      "say": "So the curve has the shape of L N of minus X. It lives to the left of X equals two.",
      "do": [
        {
          "do": "write",
          "step": 2,
          "on": "shape of L N"
        }
      ]
    },
    {
      "say": "Step three. Draw that shape against the asymptote X equals two.",
      "do": [
        {
          "do": "highlight",
          "token": "asy",
          "on": "asymptote X equals two"
        }
      ]
    },
    {
      "say": "Step four, the intercepts. When X is zero, Y is L N two, about zero point six nine three.",
      "do": [
        {
          "do": "write",
          "token": "x0",
          "on": "When X is zero"
        },
        {
          "do": "write",
          "token": "yint",
          "on": "Y is L N two"
        }
      ]
    },
    {
      "say": "When Y is zero, the inside equals E to the power zero, which is one.",
      "do": [
        {
          "do": "write",
          "token": "y0",
          "on": "When Y is zero"
        },
        {
          "do": "write",
          "token": "xin",
          "on": "the inside equals"
        }
      ]
    },
    {
      "say": "The asymptote uses inside equals zero. The intercept uses inside equals one.",
      "do": [
        {
          "do": "mark",
          "kind": "circle",
          "token": "xin",
          "on": "inside equals one"
        }
      ]
    },
    {
      "say": "So two minus X is one, and the X intercept is X equals one.",
      "do": [
        {
          "do": "write",
          "token": "ans",
          "on": "two minus X"
        },
        {
          "do": "mark",
          "kind": "box",
          "token": "ans",
          "on": "X equals one"
        }
      ]
    }
  ]
}