          "do": [
            { "do": "highlight", "token": "b3", "tone": "orange" },
            { "do": "write", "token": "b4", "on": "nine to the" }
          ]
        },
        {
          "say": "The bottom of the fraction, three, tells us which root it is: the cube root. Two over seven stays.",
