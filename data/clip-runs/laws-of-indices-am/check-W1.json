        {
          "say": "Flipped, the power is positive three.",
          "asks": ["Why is the power positive now?"],
          "do": [
            {
              "do": "note",
              "text": "Negative power flips the fraction: $\\left(\\frac{a}{b}\\right)^{-m}=\\left(\\frac{b}{a}\\right)^{m}$",
