      "heading": "Solving exponential equations",
      "steps": [
        {
          "tokens": [
            { "tex": "7^{x-1}", "id": "s7" },
            { "tex": "=" },
            { "tex": "5^{x-3}", "id": "s5" }
          ]
        },
        {
          "tokens": [
            { "tex": "\\lg 7^{x-1}", "id": "lg7" },
            { "tex": "=\\,\\lg 5^{x-3}", "id": "lg5" }
          ]
        },
        {
          "tokens": [
            { "tex": "(x-1)\\lg 7", "id": "p7", "hl": "amber" },
            { "tex": "=\\,(x-3)\\lg 5", "id": "p5", "hl": "amber" }
          ]
        },
        {
          "tokens": [
            { "tex": "x\\lg 7-\\lg 7", "id": "ex7" },
            { "tex": "=\\,x\\lg 5-3\\lg 5", "id": "ex5" }
          ]
        },
        {
          "tokens": [
            { "tex": "x\\lg 7-x\\lg 5", "id": "xs" },
            { "tex": "=\\,\\lg 7-3\\lg 5", "id": "ns" }
          ]
        },
        {
          "tokens": [
            { "tex": "x=\\dfrac{\\lg 7-3\\lg 5}{\\lg 7-\\lg 5}", "id": "frac" }
          ]
        },
        {
          "tokens": [
            { "tex": "x\\approx -8.57", "id": "ans", "hl": "emerald" }
          ]
        }
      ],
      "beats": [
        {
          "say": "Solve seven to the power X minus one equals five to the power X minus three.",
          "asks": ["Can I make the bases the same?"],
          "do": [
            { "do": "write", "step": 0 }
