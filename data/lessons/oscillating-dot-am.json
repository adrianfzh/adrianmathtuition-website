        {
          "heading": "(b)",
          "tokens": [
            { "id": "v0", "tex": "v=\\dfrac{dx}{dt}" },
            { "id": "v1", "tex": "=60\\cos\\dfrac{\\pi t}{3}\\times\\htmlClass{lsn-pc-k}{\\dfrac{\\pi}{3}}" }
          ]
        },
