            {
              "id": "q1",
              "tex": "\\dfrac{\\htmlClass{lsn-pc-a}{3^{n+1}}-\\htmlClass{lsn-pc-b}{3^{n-2}}}{\\htmlClass{lsn-pc-c}{3^{n-1}}-\\htmlClass{lsn-pc-d}{3^{n+2}}}"
