        {
          "tokens": [
            { "id": "p1", "tex": "\\text{Plan: }\\dfrac{3^n(\\,\\square\\,)}{3^n(\\,\\triangle\\,)}", "hl": "sky" },
            { "id": "p2", "tex": "=\\dfrac{\\square}{\\triangle}", "hl": "sky" }
          ]
        },
        {
          "tokens": [
            {
              "id": "s1",
              "tex": "=\\dfrac{\\htmlClass{lsn-pc-a}{\\htmlClass{lsn-pc-n}{3^n}\\times 3^1}-\\htmlClass{lsn-pc-b}{\\htmlClass{lsn-pc-n}{3^n}\\times 3^{-2}}}{\\htmlClass{lsn-pc-c}{\\htmlClass{lsn-pc-n}{3^n}\\times 3^{-1}}-\\htmlClass{lsn-pc-d}{\\htmlClass{lsn-pc-n}{3^n}\\times 3^2}}"
            }
          ]
        },
        {
          "tokens": [
            { "id": "f1", "tex": "=\\dfrac{\\htmlClass{lsn-pc-n}{3^n}(3^1-3^{-2})}{\\htmlClass{lsn-pc-n}{3^n}(3^{-1}-3^2)}" }
          ]
        },
        {
          "tokens": [
            { "id": "c1", "tex": "=\\dfrac{3^1-3^{-2}}{3^{-1}-3^2}" }
          ]
        },
        {
          "tokens": [
            { "id": "k1", "tex": "=\\dfrac{\\frac{26}{9}}{-\\frac{26}{3}}" }
          ]
