    {
      "type": "equation-steps",
      "heading": "Read m and c off the line",
      "intro": "The line passes through $(2, 3)$ and $(4, 7)$.",
      "steps": [
        {
          "tokens": [
            { "tex": "m=\\tfrac{7-3}{4-2}", "id": "grad", "hl": "amber" },
            { "tex": "=\\,2", "id": "m2" }
          ]
        },
        {
          "tokens": [
            { "tex": "3=2(2)+c", "id": "sub" },
            { "tex": "\\Rightarrow\\;c=-1", "id": "c1", "hl": "emerald" }
          ]
        },
        {
          "tokens": [
            { "tex": "-n=2", "id": "nn0" },
            { "tex": "\\Rightarrow\\;n=-2", "id": "nn", "hl": "emerald" }
          ]
        },
        {
          "tokens": [
            { "tex": "\\ln A=-1", "id": "AA0" },
            { "tex": "\\Rightarrow\\;A=e^{-1}\\approx 0.368", "id": "AA", "hl": "emerald" }
          ]
        }
      ],
      "beats": [
        {
          "say": "Gradient from the two points: seven minus three over four minus two is two.",
          "do": [
            { "do": "write", "token": "grad", "on": "seven minus three" },
            { "do": "write", "token": "m2", "on": "is two" }
          ],
          "asks": ["How do I find the gradient?"],
          "audio": "/lessons/linear-form-with-logs-am/scene-02-b1.mp3",
          "timing": "/lessons/linear-form-with-logs-am/scene-02-b1.timing.json"
        },
        {
          "say": "Substitute two, three to find C. Three equals two times two plus C, so C is minus one.",
          "do": [
            { "do": "write", "token": "sub", "on": "Three equals two" },
            { "do": "write", "token": "c1", "on": "C is minus one" }
          ],
          "asks": ["Why substitute (2, 3)?", "Which point should I use?"],
          "audio": "/lessons/linear-form-with-logs-am/scene-02-b2.mp3",
          "timing": "/lessons/linear-form-with-logs-am/scene-02-b2.timing.json"
        },
        {
          "say": "M is minus N, so minus N is two. Watch the sign: N is minus two, not two.",
          "do": [
            { "do": "write", "token": "nn0", "on": "minus N is two" },
            { "do": "write", "token": "nn", "on": "N is minus two" },
            { "do": "mark", "kind": "circle", "token": "nn", "on": "not two" }
