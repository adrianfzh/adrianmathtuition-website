        },
        {
          "tokens": [
            { "tex": "Y", "id": "Yg", "hl": "sky" },
            { "tex": "=" },
            { "tex": "m", "id": "mg", "hl": "amber" },
            { "tex": "X", "id": "Xg", "hl": "rose" },
            { "tex": "+\\,c", "id": "cg", "hl": "emerald" }
          ]
        },
        {
          "tokens": [
            { "tex": "Y=\\ln y", "id": "YY", "hl": "sky" },
            { "tex": ",\\quad X=x", "id": "XX", "hl": "rose" }
          ]
        },
        {
          "tokens": [
            { "tex": "m=-n", "id": "mm", "hl": "amber" },
            { "tex": ",\\quad c=\\ln A", "id": "ccl", "hl": "emerald" }
          ]
        }
      ],
      "beats": [
        {
          "say": "This is Linear Law. Plan: take L N of both sides, then compare with capital Y equals M capital X plus C.",
          "do": [],
          "asks": ["Why take ln, not lg?", "What is Linear Law for?"],
          "audio": "/lessons/linear-form-with-logs-am/scene-01-b1.mp3",
