        {
          "say": "For the X intercept, sub Y equals zero. Three E to the power two X equals zero.",
          "asks": ["Why put y = 0 for the x-intercept?"],
          "do": [
            { "do": "write", "token": "s0", "on": "sub Y equals" },
            { "do": "write", "token": "s3", "on": "Three E to" }
