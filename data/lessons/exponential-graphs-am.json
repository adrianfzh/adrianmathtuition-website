        },
        {
          "say": "E to the power zero is one. So Y equals three times one, which is three.",
          "asks": ["Why is e to the power 0 one?"],
          "do": [
            { "do": "write", "token": "yv", "on": "three times one" },
            { "do": "sketch", "point": 0, "on": "which is three" }
